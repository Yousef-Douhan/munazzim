# ===== الدخول =====
APP_PASSWORD=اكتب-كلمة-مرور-قوية
SESSION_SECRET=نص-عشوائي-طويل
# مفتاح يحمي رابط التشغيل الدوري /api/tick
CRON_SECRET=نص-عشوائي-آخر

# ===== المنطقة الزمنية =====
TIMEZONE=Asia/Hebron

# ===== واتساب عبر CallMeBot =====
# رقمك الذي تصله التذكيرات، بالصيغة الدولية مع +
WHATSAPP_PHONE=+9725XXXXXXXX
CALLMEBOT_APIKEY=

# ===== أو واتساب عبر Green-API (بديل CallMeBot) =====
# إذا عبّأت هذه القيم يُستخدم Green-API بدل CallMeBot
# القيم الثلاث تجدها في صفحة الـ instance في لوحة تحكم Green-API
GREENAPI_ID_INSTANCE=
GREENAPI_API_TOKEN=
GREENAPI_API_URL=https://api.green-api.com

# ===== الإيميل عبر Brevo =====
BREVO_API_KEY=
# الإيميل الذي تصل إليه التذكيرات
EMAIL_TO=
# المرسل: يجب أن يكون إيميلاً موثّقاً في Brevo (يمكن أن يكون نفس إيميلك)
EMAIL_FROM=

# ===== التخزين الدائم عبر Upstash Redis =====
# بدونها تُحفظ البيانات في ملف data.json (مناسب للتشغيل على جهازك فقط)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
